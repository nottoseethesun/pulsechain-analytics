{
  "name": "pulse-token-ratio",
  "version": "1.0.0",
  "description": "Charts the ratio of two PulseChain tokens' USD prices in the terminal, from GeckoTerminal's or Moralis's candles, with DexTools' current prices as the fallback.",
  "main": "pulse-token-ratio.js",
  "type": "module",
  "scripts": {
    "start": "node ../bin/pulse-token-ratio.js",
    "ratio": "node ../bin/pulse-token-ratio.js"
  },
  "keywords": [
    "pulsechain",
    "geckoterminal",
    "dextools",
    "token",
    "price",
    "ratio",
    "chart",
    "crypto"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "asciichart": "^1.5.25",
    "commander": "^15.1.0",
    "crypto-price-fetchers": "github:nottoseethesun/crypto-price-fetchers#main"
  },
  "engines": {
    "node": ">=24"
  }
}
